<UserControl x:Class="MONY.PartitionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <Border x:Name="Box" Padding="16,12" CornerRadius="8" BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="已挂载分区" Style="{StaticResource BodyStrongTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level2" />
                </StackPanel>
                <TextBlock x:Name="Count" Grid.Column="1" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock x:Name="Empty" Text="暂无可读取的分区" FontSize="12" />
            <Grid x:Name="Rows" RowSpacing="10" ColumnSpacing="10" />
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
