<Window
    x:Class="MONY.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MONY"
    Title="MONY">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <Grid Grid.RowSpan="2" RowDefinitions="3*,7*" IsHitTestVisible="False">
            <local:DashboardGlow Grid.Row="1" />
        </Grid>
        <Grid x:Name="AppTitleBar" Height="32" Background="Transparent" SizeChanged="TitleBarSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="40" /><ColumnDefinition x:Name="CaptionInset" Width="138" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,12,0" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                <Viewbox Width="16" Height="16">
                    <Path Width="24" Height="24" Data="M2,12 H7 L10,5 L14,19 L17,12 H22"
                          Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="MONY" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="TitleFullScreenButton" Grid.Column="1" Width="40" Height="32" MinWidth="0" MinHeight="0"
                    Background="Transparent" BorderThickness="0" Padding="8" Click="EnterFullScreen"
                    AutomationProperties.Name="全屏" ToolTipService.ToolTip="全屏">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                </Button.Resources>
                <FontIcon Glyph="&#xE740;" FontSize="16" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" SizeChanged="ResizeDashboard" PreviewKeyDown="RestoreOnEscape">
            <StackPanel x:Name="Dashboard" MaxWidth="1200" Padding="24,18,24,14">
                <local:DashboardHeader x:Name="Header" Margin="0,0,0,16" SizeChanged="ResizeCardRows"
                    PauseRequested="TogglePause" SettingsRequested="OpenSettings" TargetSelected="SelectTarget" />

                <Grid x:Name="MetricGrid" RowSpacing="12" ColumnSpacing="12">
                    <local:PartitionCard x:Name="Partitions" />
                </Grid>

                <TextBlock x:Name="DashboardFooter" Margin="0,12,0,0" SizeChanged="ResizeCardRows"
                           Text="— 表示当前没有可用读数。部分温度和功耗传感器依赖硬件驱动与权限。"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" RowDefinitions="Auto,*">
            <Grid Margin="20,8,20,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Click="CloseSettings" Content="返回性能概览" />
                <TextBlock x:Name="SettingsMessage" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <local:SettingsPane x:Name="SettingsPage" />
            </ScrollViewer>
        </Grid>
        <local:FullDashboard x:Name="FullPage" Grid.RowSpan="2" Visibility="Collapsed"
                             ExitRequested="ExitFullScreen" />
    </Grid>
</Window>
