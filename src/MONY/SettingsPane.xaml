<UserControl
    x:Class="MONY.SettingsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ShortSelect" TargetType="ComboBox">
            <Setter Property="Width" Value="146" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="12" Padding="20,12,20,24" MaxWidth="820">
        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="设备标识" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="显示名称" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox CornerRadius="6" x:Name="ComputerName" Width="146" MaxLength="64" PlaceholderText="可选"
                                 AutomationProperties.Name="显示名称" />
                        <Button CornerRadius="6" Content="确认" Click="ConfirmName" AutomationProperties.Name="确认显示名称" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="标识 IP" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="PreferredIp" Grid.Column="1" Tag="preferredIp" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="标识 IP" />
                </Grid>
                <TextBlock Text="标识 IP 用于显示和推荐地址。开启局域网后，服务监听所有接口。" Style="{StaticResource Hint}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="版本号" Style="{StaticResource RowLabel}" />
                    <TextBlock x:Name="AppVersion" Grid.Column="1" Style="{StaticResource RowLabel}" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="外观与窗口" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="桌面主题" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="DesktopTheme" Grid.Column="1" Tag="desktopTheme" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="桌面主题">
                        <ComboBoxItem Tag="system" Content="跟随 Windows" />
                        <ComboBoxItem Tag="light" Content="浅色" />
                        <ComboBoxItem Tag="dark" Content="深色" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="网页主题" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="WebTheme" Grid.Column="1" Tag="webTheme" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="网页主题">
                        <ComboBoxItem Tag="system" Content="跟随浏览器" />
                        <ComboBoxItem Tag="light" Content="浅色" />
                        <ComboBoxItem Tag="dark" Content="深色" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="最小化时" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="MinimizeTo" Grid.Column="1" Tag="minimizeTo" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="最小化时">
                        <ComboBoxItem Tag="taskbar" Content="任务栏" />
                        <ComboBoxItem Tag="tray" Content="系统托盘" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="关闭时" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="CloseTo" Grid.Column="1" Tag="closeTo" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="关闭时">
                        <ComboBoxItem Tag="tray" Content="系统托盘" />
                        <ComboBoxItem Tag="exit" Content="退出程序" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="开机自启" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="StartWithWindows" Grid.Column="1" Tag="startWithWindows" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="开机自启" />
                </Grid>
                <TextBlock Text="登录 Windows 后在托盘启动。" Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="显示信息设置" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="显示语言" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="DisplayLanguage" Grid.Column="1" Tag="language" SelectionChanged="OptionChanged"
                              Style="{StaticResource ShortSelect}" AutomationProperties.Name="显示语言">
                        <ComboBoxItem Tag="system" Content="自动（系统／浏览器）" />
                        <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                        <ComboBoxItem Tag="en" Content="English" />
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="显示共享显存" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="ShowSharedGpuMemory" Grid.Column="1" Tag="showSharedGpuMemory" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="显示共享显存" />
                </Grid>
                <StackPanel x:Name="CpuSensorOptions" Spacing="4" Visibility="Collapsed">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="CPU 温度与功耗" Style="{StaticResource RowLabel}" />
                        <Button x:Name="CpuSensorButton" Grid.Column="1" CornerRadius="6" Content="授权采集" Click="ToggleCpuSensors" />
                    </Grid>
                    <TextBlock x:Name="CpuSensorStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="对接监控" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="IP 地址" Style="{StaticResource RowLabel}" />
                    <TextBox x:Name="RemoteAddress" Grid.Column="1" CornerRadius="6" Width="146"
                             PlaceholderText="127.0.0.1" AutomationProperties.Name="IP 地址" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="API 端口" Style="{StaticResource RowLabel}" />
                    <TextBox x:Name="RemotePort" Grid.Column="1" CornerRadius="6" Width="146"
                             Text="2727" InputScope="Number" AutomationProperties.Name="API 端口" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="API 密码" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <PasswordBox x:Name="RemotePassword" Width="132" CornerRadius="6" PlaceholderText="可选"
                                     AutomationProperties.Name="对接 API 密码" />
                        <Button x:Name="ConnectRemoteButton" Content="连接" CornerRadius="6" Click="ConnectRemote" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="RemoteListRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed">
                    <TextBlock Text="已连接目标" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="RemoteList" Style="{StaticResource ShortSelect}" AutomationProperties.Name="已连接目标" />
                        <Button x:Name="RemoveRemoteButton" Content="移除" CornerRadius="6" Click="RemoveRemote" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="Web 页面" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="启用服务" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WebEnabled" Grid.Column="1" Tag="webEnabled" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="启用服务" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="局域网访问" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WebLan" Grid.Column="1" Tag="webLan" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="局域网访问" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="监听端口" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox CornerRadius="6" x:Name="WebPort" Width="105" MinWidth="0" InputScope="Number"
                                 AutomationProperties.Name="Web 监听端口" />
                        <Button CornerRadius="6" Content="确认" Tag="webPort" Click="ConfirmPort" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="网页设置密码" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <PasswordBox CornerRadius="6" x:Name="WebPassword" Width="105" MinWidth="0"
                                     AutomationProperties.Name="Web 页面密码" />
                        <Button CornerRadius="6" Content="确认" Tag="webPassword" Click="ConfirmPassword" />
                        <Button CornerRadius="6" x:Name="WebClear" Content="清除" Tag="webPassword" Click="ClearPassword" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="设置密码可选。访问设置时登录，浏览器记住授权 1 天。" Style="{StaticResource Hint}" />
                <HyperlinkButton x:Name="WebUrl" Padding="0,3" HorizontalAlignment="Right" />
                <TextBlock x:Name="WebStatus" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="数据查询 API" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="启用服务" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="ApiEnabled" Grid.Column="1" Tag="apiEnabled" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="启用服务" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="局域网访问" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="ApiLan" Grid.Column="1" Tag="apiLan" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="局域网访问" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="监听端口" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox CornerRadius="6" x:Name="ApiPort" Width="105" MinWidth="0" InputScope="Number"
                                 AutomationProperties.Name="Api 监听端口" />
                        <Button CornerRadius="6" Content="确认" Tag="apiPort" Click="ConfirmPort" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="数据 API 密码" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <PasswordBox CornerRadius="6" x:Name="ApiPassword" Width="105" MinWidth="0"
                                     AutomationProperties.Name="数据查询 API密码" />
                        <Button CornerRadius="6" Content="确认" Tag="apiPassword" Click="ConfirmPassword" />
                        <Button CornerRadius="6" x:Name="ApiClear" Content="清除" Tag="apiPassword" Click="ClearPassword" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="密码可选。局域网连接使用未加密的 HTTP。" Style="{StaticResource Hint}" />
                <HyperlinkButton x:Name="ApiUrl" Padding="0,3" HorizontalAlignment="Right" />
                <TextBlock x:Name="ApiStatus" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
                <TextBlock Text="告警通知" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Windows 通知" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WindowsNotifications" Grid.Column="1" Tag="windowsNotifications" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="Windows 通知" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="浏览器通知" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WebNotifications" Grid.Column="1" Tag="webNotifications" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="浏览器通知" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="静音 localhost 访问" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WebMuteLocal" Grid.Column="1" Tag="webMuteLocal" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="静音 localhost 访问" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="静音指定 IP 访问" Style="{StaticResource RowLabel}" />
                    <ToggleSwitch x:Name="WebMuteIps" Grid.Column="1" Tag="webMuteIps" Toggled="OptionChanged"
                                  MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="静音指定 IP 访问" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="浏览器静音 IP 列表" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="WebMutedAddresses" Width="185" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                                 CornerRadius="6" MaxLength="8192" PlaceholderText="每行一个 IP 地址"
                                 AutomationProperties.Name="浏览器静音 IP 列表" />
                        <Button Content="确认" CornerRadius="6" Click="ConfirmMutedAddresses" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="CPU 温度阈值 (°C)" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="CpuAlertCelsius" Width="92" InputScope="Number" CornerRadius="6" AutomationProperties.Name="CPU 温度阈值 (°C)" />
                        <Button Content="确认" Tag="cpuAlertCelsius" CornerRadius="6" Click="ConfirmAlertNumber" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="GPU 温度阈值 (°C)" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="GpuAlertCelsius" Width="92" InputScope="Number" CornerRadius="6" AutomationProperties.Name="GPU 温度阈值 (°C)" />
                        <Button Content="确认" Tag="gpuAlertCelsius" CornerRadius="6" Click="ConfirmAlertNumber" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="分区剩余空间阈值 (%)" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="DiskAlertPercent" Width="92" InputScope="Number" CornerRadius="6" AutomationProperties.Name="分区剩余空间阈值 (%)" />
                        <Button Content="确认" Tag="diskAlertPercent" CornerRadius="6" Click="ConfirmAlertNumber" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="告警持续时间 (秒)" Style="{StaticResource RowLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="AlertDelaySeconds" Width="92" InputScope="Number" CornerRadius="6" AutomationProperties.Name="告警持续时间 (秒)" />
                        <Button Content="确认" Tag="alertDelaySeconds" CornerRadius="6" Click="ConfirmAlertNumber" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="浏览器通知需在浏览器设置页授权。静音列表仅影响浏览器通知。"
                           Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
