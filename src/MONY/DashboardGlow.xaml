<UserControl x:Class="MONY.DashboardGlow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False" SizeChanged="Resize">
    <Rectangle>
        <Rectangle.Fill>
            <LinearGradientBrush x:Name="Glow" MappingMode="Absolute">
                <GradientStop Color="{ThemeResource DashboardGlowColor}" Offset="0" />
                <GradientStop Color="#00348CE4" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
</UserControl>
