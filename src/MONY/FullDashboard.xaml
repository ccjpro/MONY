<UserControl x:Class="MONY.FullDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MONY"
    Background="{ThemeResource InstrumentPaper}" PreviewKeyDown="EscapeFullScreen">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#EDEDEB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="{ThemeResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <Style x:Key="GlassAction" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="7" />
            </Style>
            <Style x:Key="InstrumentCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InstrumentMuted}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{ThemeResource InstrumentPaper}">
        <Grid RowDefinitions="3*,7*" IsHitTestVisible="False">
            <local:DashboardGlow x:Name="BackdropAccent" Grid.Row="1" />
        </Grid>
        <Canvas x:Name="BodyViewport">
            <Grid x:Name="Stage" RowDefinitions="3*,2*,Auto" RowSpacing="20" Padding="10,8">
                <Grid x:Name="PrimaryDeck" ColumnSpacing="32" RowSpacing="22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="2.5*" /><ColumnDefinition Width="5*" /></Grid.ColumnDefinitions>
                    <local:ProcessorInstrument x:Name="Cpu" />
                    <Border x:Name="MemoryModule" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="26,0,0,0">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="02" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" VerticalAlignment="Center" /><TextBlock Text="内存" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock x:Name="MemoryValue" Grid.Row="1" FontSize="56" FontWeight="Light" Margin="0,24,0,0" />
                            <TextBlock Grid.Row="2" Text="已用容量" FontSize="11" Foreground="{ThemeResource InstrumentMuted}" />
                            <TextBlock Grid.Row="3" Text="100" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" />
                            <Grid x:Name="MemoryScale" Grid.Row="4" MinHeight="110" RowSpacing="4" Width="56" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="5" Text="0" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" />
                            <TextBlock x:Name="MemoryDetail" Grid.Row="6" Style="{StaticResource InstrumentCaption}" />
                            <local:TimeGraph x:Name="MemoryTrend" Grid.Row="7" Height="42" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Row="8" Text="最近 60 秒" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" />
                        </Grid>
                    </Border>
                    <Border x:Name="GpuModule" Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="26,0,0,0">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><TextBlock Text="03" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="图形处理器" FontWeight="SemiBold" /><TextBlock x:Name="GpuCount" Grid.Column="2" Margin="0,0,38,0" Foreground="{ThemeResource InstrumentAccent}" FontSize="11" /></Grid>
                            <TextBlock x:Name="GpuEmpty" Text="暂无可读取的 GPU" Style="{StaticResource InstrumentCaption}" />
                            <Grid x:Name="Gpus" RowSpacing="20" ColumnSpacing="18" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="0,20,0,0">
                    <Grid x:Name="SystemsDeck" ColumnSpacing="32" RowSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="DiskModule" Spacing="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Viewbox Width="18" Height="18"><Path Width="24" Height="24" Data="M3,6 H21 V18 H3 Z M3,13 H21 M16,15 H18" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Grid.Column="1" Text="物理磁盘" FontWeight="SemiBold" /><TextBlock x:Name="DiskCount" Grid.Column="2" FontSize="11" Foreground="{ThemeResource InstrumentMuted}" /></Grid>
                            <TextBlock x:Name="DiskEmpty" Text="暂无可读取的物理磁盘" Style="{StaticResource InstrumentCaption}" />
                            <Grid x:Name="Disks" RowSpacing="16" ColumnSpacing="18" />
                        </StackPanel>
                        <Border x:Name="NetworkModule" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="26,0,0,0">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10"><Viewbox Width="18" Height="18"><Path Width="24" Height="24" Data="M8,3 H16 V8 H8 Z M3,16 H9 V21 H3 Z M15,16 H21 V21 H15 Z M12,8 V12 M6,16 V12 H18 V16" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="网络" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock x:Name="Download" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="32" FontWeight="Light" /><TextBlock x:Name="Upload" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="32" FontWeight="Light" /></StackPanel>
                                <TextBlock x:Name="NetworkDetail" Style="{StaticResource InstrumentCaption}" />
                                <local:TimeGraph x:Name="NetworkTrend" Height="56" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="最近 60 秒 · 动态量程" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="VolumeModule" Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="26,0,0,0">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Viewbox Width="18" Height="18"><Path Width="24" Height="24" Data="M3,5 H21 V19 H3 Z M3,10 H21 M8,5 V19 M12,14 H17 M12,16 H17" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Grid.Column="1" Text="挂载分区" FontWeight="SemiBold" /><TextBlock x:Name="VolumeCount" Grid.Column="2" FontSize="11" Foreground="{ThemeResource InstrumentMuted}" /></Grid>
                                <TextBlock x:Name="VolumesEmpty" Text="暂无可读取的分区" Style="{StaticResource InstrumentCaption}" />
                                <Grid x:Name="Volumes" RowSpacing="14" ColumnSpacing="18" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource InstrumentLine}" Padding="0,10,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20"><TextBlock Text="— 表示当前没有可用读数。温度与功耗依赖硬件驱动和权限。" FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource InstrumentMuted}" /><TextBlock x:Name="Version" Grid.Column="1" FontSize="10" Foreground="{ThemeResource InstrumentMuted}" /></Grid>
                </Border>
            </Grid>
        </Canvas>
        <TextBlock x:Name="Unavailable" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource InstrumentMuted}" Visibility="Collapsed" />
        <Button x:Name="Exit" Style="{StaticResource GlassAction}" Click="RequestExit" Margin="0,6,6,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="退出全屏" ToolTipService.ToolTip="退出全屏 (Esc)">
            <FontIcon Glyph="&#xE73F;" FontSize="16" />
        </Button>
    </Grid>
</UserControl>
