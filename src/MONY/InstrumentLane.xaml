<UserControl x:Class="MONY.InstrumentLane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MONY">
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBlock x:Name="Title" Foreground="{ThemeResource InstrumentAccent}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="Value" Grid.Column="1" FontSize="32" FontWeight="Light" />
        </Grid>
        <TextBlock x:Name="Detail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource InstrumentMuted}" />
        <Grid x:Name="Ruler" BorderBrush="{ThemeResource InstrumentLine}" Height="10" ColumnSpacing="3" Margin="0,4" />
        <TextBlock x:Name="Telemetry" FontSize="12" TextWrapping="Wrap" />
        <local:TimeGraph x:Name="Trend" Height="42" AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
</UserControl>
