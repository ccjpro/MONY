<Application
    x:Class="MONY.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TrendTertiaryBrush" Color="#CAB1FF" />
                    <Color x:Key="DashboardGlowColor">#4A348CE4</Color>
                    <SolidColorBrush x:Key="InstrumentPaper" Color="#111111" />
                    <SolidColorBrush x:Key="InstrumentMuted" Color="#A4A4A0" />
                    <SolidColorBrush x:Key="InstrumentLine" Color="#363634" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="#F2B466" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TrendTertiaryBrush" Color="#7351B8" />
                    <Color x:Key="DashboardGlowColor">#404481D9</Color>
                    <SolidColorBrush x:Key="InstrumentPaper" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="InstrumentMuted" Color="#686866" />
                    <SolidColorBrush x:Key="InstrumentLine" Color="#D7D7D3" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="#9D5C00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TrendTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <Color x:Key="DashboardGlowColor">Transparent</Color>
                    <SolidColorBrush x:Key="InstrumentPaper" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InstrumentMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InstrumentLine" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InstrumentAccent" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
