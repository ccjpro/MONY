<UserControl x:Class="MONY.DashboardHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OverviewAction" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="性能概览" FontSize="28" FontWeight="SemiBold" LineHeight="36"
                   VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
            <Button x:Name="Identity" Padding="4,2" MinWidth="0" MaxWidth="220" Background="Transparent"
                    BorderThickness="0" AutomationProperties.Name="监控目标">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                </Button.Resources>
                <Button.Flyout><MenuFlyout x:Name="TargetMenu" /></Button.Flyout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                    <TextBlock x:Name="TargetLabel" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <FontIcon x:Name="TargetArrow" Grid.Column="1" Glyph="&#xE70D;" FontSize="9" />
                </Grid>
            </Button>
            <TextBlock x:Name="SampleTime" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Status" Grid.Column="2" FontSize="12" MaxWidth="126" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="Pause" Style="{StaticResource OverviewAction}" Click="RequestPause" AutomationProperties.Name="暂停" ToolTipService.ToolTip="暂停">
                <FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource OverviewAction}" Click="RequestSettings" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
